{
  "entity": {
    "binary_sensor": {
      "battery_charging": { "default": "mdi:battery" },
      "system_pending_reboot": { "default": "mdi:restart-alert" },
      "session_ready": {
        "default": "mdi:account-off-outline",
        "state": { "on": "mdi:account-check-outline" }
      },
      "session_locked": {
        "default": "mdi:lock-open-variant-outline",
        "state": { "on": "mdi:lock-outline" }
      },
      "agent_paused": {
        "default": "mdi:wrench-outline",
        "state": { "on": "mdi:wrench" }
      },
      "power_keep_awake": {
        "default": "mdi:coffee-off-outline",
        "state": { "on": "mdi:coffee" }
      },
      "audio_muted": {
        "default": "mdi:volume-high",
        "state": { "on": "mdi:volume-off" }
      },
      "privacy_microphone_in_use": {
        "default": "mdi:microphone-off",
        "state": { "on": "mdi:microphone" }
      },
      "sim_toggle": {
        "default": "mdi:toggle-switch-off-outline",
        "state": { "on": "mdi:toggle-switch-outline" }
      }
    },
    "button": {
      "wake_on_lan": { "default": "mdi:lan-connect" }
    },
    "event": {
      "events": { "default": "mdi:bell-outline" }
    },
    "notify": {
      "notification": { "default": "mdi:message-badge-outline" }
    },
    "media_player": {
      "media_player": { "default": "mdi:play-box-outline" }
    },
    "update": {
      "agent": { "default": "mdi:update" }
    },
    "sensor": {
      "agent_version": { "default": "mdi:tag-outline" },
      "agent_latest_version": { "default": "mdi:tag-plus-outline" },
      "agent_release_url": { "default": "mdi:link-variant" },
      "agent_release_notes": { "default": "mdi:text-box-outline" },
      "cpu_usage": { "default": "mdi:cpu-64-bit" },
      "gpu_usage": { "default": "mdi:expansion-card" },
      "memory_used_percent": { "default": "mdi:memory" },
      "memory_used": { "default": "mdi:memory" },
      "memory_total": { "default": "mdi:memory" },
      "net_ipv4": { "default": "mdi:ip-network" },
      "battery_level": { "default": "mdi:battery" },
      "system_uptime": { "default": "mdi:timer-outline" },
      "system_last_boot": { "default": "mdi:restart" },
      "system_os_version": { "default": "mdi:microsoft-windows" },
      "session_user": { "default": "mdi:account" },
      "session_idle_seconds": { "default": "mdi:timer-sand" },
      "window_title": { "default": "mdi:application-outline" },
      "window_process": { "default": "mdi:application-cog-outline" },
      "audio_volume": { "default": "mdi:volume-high" },
      "audio_output_device": { "default": "mdi:speaker" },
      "audio_input_device": { "default": "mdi:microphone-settings" },
      "media_state": {
        "default": "mdi:play-pause",
        "state": {
          "playing": "mdi:play",
          "paused": "mdi:pause",
          "idle": "mdi:stop"
        }
      },
      "media_title": { "default": "mdi:music" },
      "media_artist": { "default": "mdi:account-music" },
      "media_album": { "default": "mdi:album" },
      "media_app": { "default": "mdi:application-brackets-outline" },
      "media_duration": { "default": "mdi:timer-outline" },
      "media_position": { "default": "mdi:progress-clock" },
      "media_position_updated_at": { "default": "mdi:clock-check-outline" },
      "sim_cpu": { "default": "mdi:cpu-64-bit" },
      "sim_counter": { "default": "mdi:counter" },
      "sim_mode": {
        "default": "mdi:state-machine",
        "state": {
          "idle": "mdi:sleep",
          "active": "mdi:run",
          "busy": "mdi:progress-clock"
        }
      },
      "power_state": {
        "default": "mdi:power",
        "state": {
          "running": "mdi:desktop-tower-monitor",
          "sleep": "mdi:power-sleep",
          "hibernate": "mdi:power-sleep",
          "shutdown": "mdi:power",
          "restart": "mdi:restart",
          "unknown": "mdi:help-circle-outline"
        }
      }
    }
  },
  "services": {
    "run_command": {
      "service": "mdi:console-line"
    },
    "send_notification": {
      "service": "mdi:message-badge"
    }
  }
}
