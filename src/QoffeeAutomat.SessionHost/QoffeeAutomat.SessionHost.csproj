<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs inside each interactive user session and talks to the agent over a named pipe
       (D-009, S11). A WinExe has no console window; the agent starts it with the token of the user
       (WTSQueryUserToken, CreateProcessAsUser). It runs user-context commands with the runners of Core
       (T303). The tray icon (Windows Forms NotifyIcon, T310) lives in Tray/. -->

  <!-- The target framework names a Windows version (10.0.19041, Windows 10 version 2004) so that the Windows Runtime APIs are
       projected into .NET: the toast notifications of notify.toast (Notifications/, T702) and the system media transport
       controls (Media/, T716) have no other way in without an extra package. A project that references this one needs the
       same or a higher platform version: the test project of the Windows platform has it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>QoffeeAutomat.SessionHost</AssemblyName>
    <RootNamespace>QoffeeAutomat.SessionHost</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\brand\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Windows Forms adds System.Windows.Forms and System.Drawing to the implicit usings; their names (Timer, Size, ...)
       would collide with the System.* types that the rest of the project uses, so the tray code imports them itself. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QoffeeAutomat.Contracts\QoffeeAutomat.Contracts.csproj" />
    <!-- The same process runner and PowerShell wrapper as the agent uses (PLAN.md T303). -->
    <ProjectReference Include="..\QoffeeAutomat.Core\QoffeeAutomat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The base of the tray icons (assets/brand is the single source of all icons, PLAN.md S05). -->
    <EmbeddedResource Include="..\..\assets\brand\app.ico" LogicalName="QoffeeAutomat.SessionHost.app.ico" />
  </ItemGroup>

</Project>
