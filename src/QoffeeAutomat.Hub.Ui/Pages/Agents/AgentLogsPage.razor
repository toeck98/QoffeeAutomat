@page "/agents/{AgentId}/logs"
@using QoffeeAutomat.Ui.Components.Pages.History

@* The log of the agent (the component library, through the tunnel). *@
<AgentPageFrame AgentId="@AgentId" Tab="logs" MinRole="@HubRoleNames.Viewer">
  <LogsPage />
</AgentPageFrame>

@code {
  /// <summary>The id of the agent.</summary>
  [Parameter]
  public string AgentId { get; set; } = string.Empty;
}
