@page "/agents/{AgentId}/secrets"
@using QoffeeAutomat.Ui.Components.Pages.Secrets

@* The named secrets of the agent (the component library, through the tunnel); the values are never shown, as on the agent itself. *@
<AgentPageFrame AgentId="@AgentId" Tab="secrets" MinRole="@HubRoleNames.Admin">
  <SecretsPage />
</AgentPageFrame>

@code {
  /// <summary>The id of the agent.</summary>
  [Parameter]
  public string AgentId { get; set; } = string.Empty;
}
