@inherits LocalizedComponentBase

@* The named secrets that the command receives as QA_SECRET_<NAME> environment variables (PLAN.md S09, T706). Only PowerShell and
   process actions can use them, like the validator says. A name that the command lists but that is not stored is kept and
   flagged, so that it can be seen and removed. *@
<MudPaper Class="pa-4 mb-4 qa-card" Elevation="1" data-testid="section-secrets">
  <div class="qa-card-header">
    <MudText Typo="Typo.h6">@L["Editor.Secrets.Title"]</MudText>
    <MudButton Size="Size.Small" Variant="Variant.Text" Href="/secrets" data-testid="secrets-manage">@L["Editor.Secrets.Manage"]</MudButton>
  </div>

  @if (!Draft.SupportsSecrets)
  {
    <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="secrets-not-available">@L["Editor.Secrets.NotAvailable"]</MudText>
  }
  else
  {
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@L["Editor.Secrets.Help"]</MudText>
    IReadOnlyList<string> names = Choices();
    if (names.Count == 0)
    {
      <MudText Color="Color.Secondary" data-testid="secrets-none">@L["Editor.Secrets.None"]</MudText>
    }

    <div class="qa-check-group" role="group" aria-label="@L["Editor.Secrets.Title"]" data-testid="secret-choices">
      @foreach (string name in names)
      {
        string current = name;
        bool stored = Stored.Contains(current);
        <label class="qa-check" data-testid="@($"secret-choice-{current}")" data-stored="@(stored ? "true" : "false")">
          <input type="checkbox"
                 checked="@Draft.Secrets.Contains(current)"
                 @onchange="@((ChangeEventArgs args) => ToggleAsync(current, args.Value is true))"
                 data-testid="@($"secret-input-{current}")" />
          <span>@current</span>
          @if (!stored)
          {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" data-testid="@($"secret-missing-{current}")">@L["Editor.Secrets.Missing"]</MudChip>
          }
        </label>
      }
    </div>
    <FieldError Errors="Errors" Path="/secrets" />
    @for (int index = 0; index < Draft.Secrets.Count; index++)
    {
      <FieldError Errors="Errors" Path="@("/secrets/" + index)" />
    }
  }
</MudPaper>

@code {
  /// <summary>The draft.</summary>
  [Parameter]
  [EditorRequired]
  public CommandDraft Draft { get; set; } = null!;

  /// <summary>The problems of the draft.</summary>
  [Parameter]
  public DraftErrors Errors { get; set; } = DraftErrors.Empty;

  /// <summary>The names of the secrets that the agent has stored.</summary>
  [Parameter]
  public IReadOnlyList<string> Stored { get; set; } = [];

  /// <summary>Raised after every change of the draft.</summary>
  [Parameter]
  public EventCallback OnChanged { get; set; }

  /// <summary>The stored names and the ones that the command lists without them being stored, ordered.</summary>
  private IReadOnlyList<string> Choices()
  {
    return [.. Stored.Concat(Draft.Secrets).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal)];
  }

  private Task ToggleAsync(string name, bool selected)
  {
    if (selected && !Draft.Secrets.Contains(name))
    {
      Draft.Secrets.Add(name);
      Draft.Secrets.Sort(StringComparer.Ordinal);
    }
    else if (!selected)
    {
      Draft.Secrets.Remove(name);
    }

    return OnChanged.InvokeAsync();
  }
}
