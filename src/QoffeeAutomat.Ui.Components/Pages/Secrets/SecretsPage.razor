@page "/secrets"
@using QoffeeAutomat.Contracts.Api
@inherits LocalizedComponentBase

@* The named secrets of scripts (PLAN.md T706): names and the commands that use them, and a form to add a secret or replace its
   value. Values are write-only: the agent never returns one, and the field is emptied as soon as it was sent. *@
<div class="qa-card-header">
  <MudText Typo="Typo.h4" GutterBottom="true">@L["Secrets.Title"]</MudText>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@L["Secrets.Intro"]</MudText>

<ErrorDisplay Error="_listError" OnRetry="ReloadAsync" Class="mb-4" />
@if (_actionError is not null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-2" data-testid="action-failed">@_actionFailure</MudAlert>
  <ErrorDisplay Error="_actionError" Class="mb-4" />
}
@if (_notice is not null)
{
  <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" data-testid="notice">@_notice</MudAlert>
}

<MudPaper Class="pa-4 mb-4 qa-card" Elevation="1" data-testid="secret-form">
  <MudText Typo="Typo.h6" Class="mb-1">@L["Secrets.Form.Title"]</MudText>
  <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" data-testid="secret-write-only">@L["Secrets.Form.Help"]</MudText>
  @if (_saveError is not null)
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-2" data-testid="save-failed">@_saveFailure</MudAlert>
    <ErrorDisplay Error="_saveError" Class="mb-2" />
  }
  <MudGrid Spacing="2">
    <MudItem xs="12" md="5">
      <div data-testid="field-secret-name">
        <MudTextField T="string"
                      @bind-Value="_name"
                      Immediate="true"
                      TextUpdateSuppression="false"
                      Label="@L["Secrets.Field.Name"]"
                      HelperText="@L["Secrets.Field.Name.Help"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      spellcheck="false"
                      autocomplete="off" />
      </div>
    </MudItem>
    <MudItem xs="12" md="5">
      <div data-testid="field-secret-value">
        <MudTextField T="string"
                      @bind-Value="_value"
                      Immediate="true"
                      TextUpdateSuppression="false"
                      InputType="InputType.Password"
                      Label="@L["Secrets.Field.Value"]"
                      HelperText="@L["Secrets.Field.Value.Help"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      spellcheck="false"
                      autocomplete="new-password" />
      </div>
    </MudItem>
    <MudItem xs="12" md="2">
      <MudButton Variant="Variant.Filled"
                 Color="Color.Primary"
                 StartIcon="@Icons.Material.Filled.Save"
                 Disabled="@(_saving || _name.Trim().Length == 0 || _value.Length == 0)"
                 OnClick="SaveAsync"
                 data-testid="secret-save">@L["Secrets.Save"]</MudButton>
    </MudItem>
  </MudGrid>
</MudPaper>

@if (_loading)
{
  <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@L["Common.Loading"]" />
}
else if (_secrets.Count == 0)
{
  if (_listError is null)
  {
    <MudPaper Class="pa-4 qa-card" Elevation="1">
      <MudText Color="Color.Secondary" data-testid="secrets-none">@L["Secrets.None"]</MudText>
    </MudPaper>
  }
}
else
{
  <MudPaper Class="qa-card" Elevation="1">
    <MudSimpleTable Dense="true" Hover="true" data-testid="secret-table">
      <thead>
        <tr>
          <th>@L["Secrets.Column.Name"]</th>
          <th>@L["Secrets.Column.Variable"]</th>
          <th>@L["Secrets.Column.UsedBy"]</th>
          <th>@L["Secrets.Column.Actions"]</th>
        </tr>
      </thead>
      <tbody>
        @foreach (SecretSummary secret in _secrets)
        {
          <tr @key="secret.Name" data-testid="@($"secret-{secret.Name}")">
            <td><div class="qa-command-name">@secret.Name</div></td>
            <td><code>@VariableOf(secret.Name)</code></td>
            <td data-testid="@($"used-by-{secret.Name}")">@UsedByText(secret)</td>
            <td>
              <MudButton Size="Size.Small"
                         Variant="Variant.Outlined"
                         Disabled="@IsBusy(secret.Name)"
                         OnClick="@(() => Replace(secret))"
                         aria-label="@(L["Secrets.Replace"] + ": " + secret.Name)"
                         data-testid="@($"replace-{secret.Name}")">@L["Secrets.Replace"]</MudButton>
              <MudButton Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="Color.Error"
                         Disabled="@IsBusy(secret.Name)"
                         OnClick="@(() => DeleteAsync(secret))"
                         aria-label="@(L["Secrets.Delete"] + ": " + secret.Name)"
                         data-testid="@($"delete-{secret.Name}")">@L["Secrets.Delete"]</MudButton>
            </td>
          </tr>
        }
      </tbody>
    </MudSimpleTable>
  </MudPaper>
}
