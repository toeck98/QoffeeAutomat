@page "/logs"
@using QoffeeAutomat.Ui.Components.Pages.Dashboard
@inherits LocalizedComponentBase

@* The log viewer (PLAN.md T407): the newest entries of the agent log, newest first, with a level filter and a follow mode that
   reads them again while the page is open. *@
<div class="qa-card-header">
  <MudText Typo="Typo.h4" GutterBottom="true">@L["Logs.Title"]</MudText>
  <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" data-testid="logs-refresh">@L["History.Refresh"]</MudButton>
</div>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@L["Logs.Intro"]</MudText>

<MudPaper Class="pa-3 mb-3 qa-card" Elevation="1" data-testid="log-filters">
  <MudGrid Spacing="2" Class="align-center">
    <MudItem xs="6" md="3">
      <SelectBox Label="@L["Logs.Level"]" Value="@_level" ValueChanged="SetLevelAsync" TestId="log-level">
        @foreach (string level in Levels)
        {
          <option value="@level" selected="@(level == _level)">@L["Settings.LogLevel." + level]</option>
        }
      </SelectBox>
    </MudItem>
    <MudItem xs="6" md="3">
      <SelectBox Label="@L["Logs.Limit"]" Value="@_limit.ToString(System.Globalization.CultureInfo.InvariantCulture)" ValueChanged="SetLimitAsync" TestId="log-limit">
        @foreach (int limit in Limits)
        {
          <option value="@limit" selected="@(limit == _limit)">@limit</option>
        }
      </SelectBox>
    </MudItem>
    <MudItem xs="12" md="3">
      <div data-testid="log-search">
        <MudTextField T="string" @bind-Value="_search" Immediate="true" Clearable="true" Label="@L["Logs.Search"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
      </div>
    </MudItem>
    <MudItem xs="12" md="3">
      <span data-testid="log-follow" data-checked="@(_follow ? "true" : "false")">
        <MudSwitch T="bool" Value="_follow" ValueChanged="SetFollowAsync" Color="Color.Primary" Label="@L["Logs.Follow"]" />
      </span>
    </MudItem>
  </MudGrid>
</MudPaper>

<ErrorDisplay Error="_error" OnRetry="ReloadAsync" Class="mb-3" />
@if (_loading)
{
  <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@L["Common.Loading"]" />
}
else if (VisibleEntries.Count == 0)
{
  if (_error is null)
  {
    <MudPaper Class="pa-4 qa-card" Elevation="1">
      <MudText Color="Color.Secondary" data-testid="logs-none">@L["Logs.None"]</MudText>
    </MudPaper>
  }
}
else
{
  <pre class="qa-run-output qa-log" data-testid="log-output" data-count="@VisibleEntries.Count">@foreach (LogEntry entry in VisibleEntries) {<span class="@LineClass(entry)" data-testid="log-line" data-level="@entry.Level.ToLowerInvariant()">@DashboardFormat.LocalTime(entry.Timestamp, L.Culture) @entry.Level.ToUpperInvariant() @entry.Category: @entry.Message</span>if (entry.Exception is not null) {<span class="qa-log-exception" data-testid="log-exception">@entry.Exception</span>}}</pre>
}
