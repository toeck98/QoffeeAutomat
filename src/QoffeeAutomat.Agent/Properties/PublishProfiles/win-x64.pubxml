<?xml version="1.0" encoding="utf-8"?>
<!-- Publish profile of the agent for win-x64 (PLAN.md S13, T601): self-contained, single file, ReadyToRun, no symbols.
     The version comes from Directory.Build.props (release-please) and is stamped into the file version resource and the
     informational version; packaging/windows/publish.ps1 overrides it with -p:Version=. The application icon is
     assets/brand/app.ico, set in the project file.

     Use it together with the Windows target framework, which the project builds next to the plain one:
       dotnet publish src/QoffeeAutomat.Agent -c Release -f net10.0-windows -r win-x64 -p:PublishProfile=win-x64
     packaging/windows/publish.ps1 does this for both executables and stages the result. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Native libraries (SQLite) stay next to the executable instead of being extracted into a temporary directory at
         start-up: the service runs as LocalSystem and must not load code from a folder that it unpacked itself. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No IIS: the service is hosted by Kestrel. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\agent\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
