# Settings of packaging/hub/docker-compose.yml. Copy to ".env" (git-ignored) and change what you need.
# Every line is optional; the value shown is the default. The file holds no secret.

# Release of the hub image, for example 0.2.0. "latest" is the newest stable release.
QOFFEE_HUB_VERSION=latest

# Port on the Docker host that is mapped to the hub (the hub itself always listens on 8490 in the container).
QOFFEE_HUB_PUBLISHED_PORT=8490

# Name of a new hub (shown in the UI and in Home Assistant). Only used when the hub starts for the first time.
QOFFEE_HUB_NAME=QoffeeAutomat Hub

# selfsigned | certificate | none (plain HTTP behind a reverse proxy that terminates TLS).
QOFFEE_HUB_TLS=selfsigned

# Reverse proxies whose X-Forwarded-* headers are trusted: addresses or CIDR ranges, separated by commas.
# Required with QOFFEE_HUB_TLS=none.
QOFFEE_HUB_TRUSTED_PROXIES=

# json (default in a container) | text
QOFFEE_HUB_LOG_FORMAT=json

# Metric history: collection interval in seconds and retention of raw samples (hours) and of the
# 5 minute and 1 hour roll-ups (days). See "Sizing the hub for metric history" before raising them.
QOFFEE_HUB_METRICS_INTERVAL=60
QOFFEE_HUB_RETENTION_RAW_HOURS=48
QOFFEE_HUB_RETENTION_5M_DAYS=30
QOFFEE_HUB_RETENTION_1H_DAYS=730
