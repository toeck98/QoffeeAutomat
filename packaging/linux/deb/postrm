#!/bin/sh
# QoffeeAutomat .deb: after removal. "remove" keeps configuration, data and logs; "purge" deletes them.
set -e

case "$1" in
  remove | purge)
    if [ -d /run/systemd/system ]; then
      systemctl --global disable qoffeeautomat-session.service > /dev/null 2>&1 || true
      systemctl daemon-reload || true
    fi
    ;;
esac

if [ "$1" = "purge" ]; then
  rm -rf /etc/qoffeeautomat /var/lib/qoffeeautomat /var/log/qoffeeautomat
fi

exit 0
