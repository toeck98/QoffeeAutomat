    {
      "id": "audio.volume",
      "name": "Master volume",
      "translation_key": "audio_volume",
      "kind": "sensor",
      "value_type": "number",
      "unit": "%",
      "icon": "mdi:volume-high",
      "precision": 0,
      "enabled_default": true,
      "interval_seconds": 0
    }
  ],
  "commands": [
    {
      "id": "set_display_profile",
      "name": "Set display profile",
      "icon": "mdi:monitor-multiple",
      "description": "Applies a saved DisplayConfig profile.",
      "returns_output": true,
      "vars": [
        { "name": "Profile", "type": "enum", "options": ["Normal-Mode", "TV-Mode"], "required": true },
        { "name": "UpdateAdapterIds", "type": "bool", "default": false }
      ],
      "control": { "type": "select", "var": "Profile" }
    },
    {
      "id": "set_volume",
      "name": "Set volume",
      "icon": "mdi:volume-high",
      "vars": [
        { "name": "Level", "type": "int", "required": true, "min": 0, "max": 100, "step": 1, "unit": "%" }
      ],
      "control": { "type": "number", "var": "Level", "state_metric": "audio.volume" }
    },
    {
      "id": "lock_session",
      "name": "Lock session",
      "icon": "mdi:lock",
      "control": { "type": "button" }
    },
    {
      "id": "say_text",
      "name": "Say text",
      "vars": [
        { "name": "Message", "type": "string", "required": true, "max_length": 200, "pattern": "^[A-Za-z0-9 .,!?-]+$" }
      ],
      "control": { "type": "text", "var": "Message" }
    }
  ],
  "events": [
    { "type": "session_locked", "name": "Session locked" },
