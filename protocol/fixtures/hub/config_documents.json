      "hash": "5c4c8f76eb29b3f8f5f1723dac0cccb277dc69c4b8adb9b32717674db392ee5b",
      "body": "param([Parameter(Mandatory)][string]$Profile, [bool]$UpdateAdapterIds = $false)\nUse-DisplayConfig -Name $Profile\n"
    },
