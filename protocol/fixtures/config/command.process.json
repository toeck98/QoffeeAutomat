{
  "schemaVersion": 1,
  "id": "open_url",
  "name": "Open URL",
  "enabled": true,
  "exposeToHa": false,
  "runAs": "user",
  "action": {
    "type": "process",
    "file": "C:\\Program Files\\Mozilla Firefox\\firefox.exe",
    "args": ["-new-tab", "{{Url}}"],
    "waitForExit": false
  },
  "parameters": [
    { "name": "Url", "type": "string", "required": true, "maxLength": 2048, "pattern": "^https://" }
  ],
  "haControl": { "type": "text", "parameter": "Url" }
}
