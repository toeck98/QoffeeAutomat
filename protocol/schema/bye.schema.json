{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toeck98/QoffeeAutomat/protocol/schema/bye.schema.json",
  "title": "bye",
  "description": "Agent to client. The agent goes away deliberately (PLAN.md S07).",
  "type": "object",
  "required": ["t", "reason"],
  "properties": {
    "t": { "const": "bye" },
    "reason": { "enum": ["sleep", "hibernate", "shutdown", "restart", "service_stop", "update"] }
  }
}
