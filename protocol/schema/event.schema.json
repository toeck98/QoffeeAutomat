{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toeck98/QoffeeAutomat/protocol/schema/event.schema.json",
  "title": "event",
  "description": "Agent to client. Something happened on the PC (PLAN.md S07).",
  "type": "object",
  "required": ["t", "type", "ts"],
  "properties": {
    "t": { "const": "event" },
    "type": { "type": "string", "minLength": 1 },
    "ts": {
      "description": "Unix time in milliseconds.",
      "type": "integer",
      "minimum": 0
    },
    "data": { "type": "object" }
  }
}
