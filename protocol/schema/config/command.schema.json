{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toeck98/QoffeeAutomat/protocol/schema/config/command.schema.json",
  "title": "Command document",
  "description": "config/commands/<id>.json (PLAN.md S06). Defaults: parameters [], haControl {type: none}, timeoutSeconds 60, concurrency single, cooldownSeconds 0, captureOutput false.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "enabled", "exposeToHa", "runAs", "action"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schema_version" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/updated_at" },
    "origin": { "$ref": "common.schema.json#/$defs/origin" },
    "id": { "$ref": "common.schema.json#/$defs/document_id" },
    "name": { "$ref": "common.schema.json#/$defs/display_name" },
    "description": { "type": "string", "maxLength": 2000 },
    "icon": { "$ref": "common.schema.json#/$defs/icon" },
    "enabled": { "type": "boolean" },
    "exposeToHa": { "type": "boolean" },
    "runAs": { "enum": ["system", "user", "user_elevated"] },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["powershell", "process", "builtin", "sequence"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "powershell" } }, "required": ["type"] },
          "then": { "$ref": "common.schema.json#/$defs/powershell_source" }
        },
        {
          "if": { "properties": { "type": { "const": "process" } }, "required": ["type"] },
          "then": {
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "workingDirectory": { "type": "string" },
              "waitForExit": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "builtin" } }, "required": ["type"] },
          "then": {
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "sequence" } }, "required": ["type"] },
          "then": {
            "required": ["steps"],
            "properties": {
              "steps": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sequence_step" } },
              "onError": { "enum": ["stop", "continue"] }
            }
          }
        }
      ]
    },
    "parameters": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/parameter" } },
    "haControl": { "$ref": "common.schema.json#/$defs/ha_control" },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "concurrency": { "enum": ["single", "queue", "parallel", "restart"] },
    "cooldownSeconds": { "type": "integer", "minimum": 0 },
    "captureOutput": { "type": "boolean" },
    "conditions": {
      "description": "Schema version 2 (T705). A run that does not meet the conditions is rejected with the error condition_not_met.",
      "type": "object",
      "properties": {
        "session": {
          "description": "The session state that the command needs; absent means any.",
          "enum": ["any", "logged_in", "unlocked", "locked"]
        },
        "timeWindow": {
          "description": "The command only runs inside this window of the local day. An end that is not later than the start makes the window cross midnight.",
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "to": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "days": {
              "description": "The days on which the window starts; absent or empty means every day.",
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
            }
          }
        }
      }
    },
    "secrets": {
      "description": "Schema version 2 (T706). Names of the secrets that the run receives as the environment variables QA_SECRET_<NAME> (upper case). Only for powershell and process actions.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
    }
  }
}
