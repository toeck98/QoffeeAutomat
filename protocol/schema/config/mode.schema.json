{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toeck98/QoffeeAutomat/protocol/schema/config/mode.schema.json",
  "title": "Mode group document",
  "description": "config/modes/<id>.json (PLAN.md S06, T717). A set of mutually exclusive modes of the PC. The group appears as the generated command mode_<id> and the enum metric mode.<id>.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "enabled", "exposeToHa", "defaultMode", "modes"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schema_version" },
    "revision": { "$ref": "common.schema.json#/$defs/revision" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/updated_at" },
    "origin": { "$ref": "common.schema.json#/$defs/origin" },
    "id": { "$ref": "common.schema.json#/$defs/document_id" },
    "name": { "$ref": "common.schema.json#/$defs/display_name" },
    "description": { "type": "string", "maxLength": 2000 },
    "icon": { "$ref": "common.schema.json#/$defs/icon" },
    "enabled": { "type": "boolean" },
    "exposeToHa": { "type": "boolean" },
    "defaultMode": { "$ref": "common.schema.json#/$defs/document_id" },
    "onBoot": { "enum": ["keep", "reset", "apply_default"] },
    "onError": { "enum": ["stop", "continue"] },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/document_id" },
          "name": { "$ref": "common.schema.json#/$defs/display_name" },
          "enter": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sequence_step" } },
          "exit": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sequence_step" } }
        }
      }
    }
  }
}
