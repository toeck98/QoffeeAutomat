{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toeck98/QoffeeAutomat/protocol/schema/config/common.schema.json",
  "title": "Configuration document definitions",
  "description": "Definitions shared by the configuration documents (PLAN.md S06). Property names are camelCase. Unknown properties are allowed so that documents written by a newer version still load; semantic rules are enforced by DocumentValidator in QoffeeAutomat.Core.",
  "$defs": {
    "schema_version": {
      "description": "Version of the document schema.",
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "description": "Incremented by the store on every save; absent in documents that were not stored yet.",
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "description": "UTC time of the last save, ISO 8601.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "origin": {
      "description": "Where the document was authored.",
      "enum": ["local", "hub"]
    },
    "document_id": {
      "description": "Id of a command or sensor.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "icon": {
      "description": "An icon reference such as mdi:monitor-multiple.",
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_-]+$"
    },
    "metric_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_-]+)*$",
      "maxLength": 128
    },
    "parameter": {
      "description": "A command variable (R-04).",
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
        "type": { "enum": ["string", "int", "float", "bool", "enum"] },
        "required": { "type": "boolean" },
        "default": { "type": ["string", "number", "boolean"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "pattern": { "type": "string" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "optionsFrom": { "$ref": "#/$defs/metric_id" },
        "secret": { "type": "boolean" },
        "unit": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ha_control": {
      "description": "Maps a command to a Home Assistant entity.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "button", "switch", "select", "number", "text"] },
        "parameter": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
        "stateMetric": { "oneOf": [{ "$ref": "#/$defs/metric_id" }, { "type": "null" }] }
      }
    },
    "powershell_source": {
      "description": "PowerShell code: inline in the document or a file in the scripts directory.",
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "enum": ["inline", "file"] },
        "code": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "engine": { "enum": ["auto", "pwsh", "powershell"] }
      },
      "allOf": [
        { "if": { "properties": { "source": { "const": "inline" } }, "required": ["source"] }, "then": { "required": ["code"] } },
        { "if": { "properties": { "source": { "const": "file" } }, "required": ["source"] }, "then": { "required": ["script"] } }
      ]
    },
    "sequence_step": {
      "description": "A step of a sequence: run a command or wait.",
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/document_id" },
        "vars": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "delaySeconds": { "type": "number", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["command"] },
        { "required": ["delaySeconds"] }
      ]
    }
  }
}
