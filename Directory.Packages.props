<Project>

  <!-- Central package management. Versions looked up on 2026-11-14; Dependabot keeps them
       current (PLAN.md S01 rule 9). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Same release train as the ASP.NET Core packages below; used by the Agent tests (T201). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <!-- SQLite for the run history and the recent events (PLAN.md D-013, T207, T217). Microsoft.Data.Sqlite
         follows the .NET 10 servicing train like the ASP.NET Core packages; it brings the native SQLite
         library for Windows and Linux (SQLitePCLRaw bundle). Dependabot keeps it current. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Windows">
    <!-- Windows service hosting, Event Log, service control and DPAPI for Platform.Windows (T301). They ship
         with the .NET 10 servicing train, like the ASP.NET Core packages above; Dependabot keeps them current. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <!-- Performance counters (GPU Engine, the perf_counter sensor) and WMI (the cim_query sensor) for the system metrics and
         the Windows custom sensor types (T304, T307); same release train as the packages above. -->
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.15" />
    <PackageVersion Include="System.Management" Version="10.0.15" />
    <!-- Hardware sensors (T707, ADR 0002); MPL-2.0. Must be a release that uses the PawnIO driver and not WinRing0 (0.9.5 or newer; the
         agent refuses older ones at run time, see HardwareLibraryGuard).
         NOT VERIFIED: the agent that wrote this had no network access, so the version number is the oldest release that ADR 0002 accepts,
         not the current one. Look up the current stable release on nuget.org, pin it here and check its dependencies before merging
         (PLAN.md S01 rule 9); Dependabot keeps it current afterwards. -->
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup Label="Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" />
    <!-- Serves the published WebAssembly files (_framework, with the right media types) from the agent (T401). -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <!-- Component library of the UI (D-015). All its CSS, JavaScript and fonts ship inside the package and are served
         from the agent; nothing is loaded from a CDN. Dependabot keeps it current. -->
    <PackageVersion Include="MudBlazor" Version="8.15.0" />
    <!-- The Monaco editor for PowerShell in the command editor (T404). The package carries Monaco itself under
         _content/BlazorMonaco/, so the agent serves it and nothing is loaded from a CDN. Dependabot keeps it current. -->
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup Label="UI tests">
    <!-- Component tests of Ui.Components (T401). -->
    <PackageVersion Include="bunit" Version="2.15.2" />
    <!-- Transitive pin above GHSA-pgww-w46g-26qg. -->
    <PackageVersion Include="AngleSharp" Version="1.10.4" />
    <!-- Headless Chromium for the browser smoke test of the UI (T408); CI installs the browser with playwright.ps1. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

</Project>
